// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  email         String   @unique
  password_hash String
  username      String   @unique
  display_name  String?
  avatar_url    String?
  email_verified Boolean  @default(false)
  ai_enabled     Boolean  @default(false) // habilita el asistente IA (beta)
  is_admin       Boolean  @default(false) // panel admin; solo se asigna por DB
  plan_id        Int?
  plan           Plan?    @relation(fields: [plan_id], references: [id], onDelete: SetNull)
  referral_code  String?  @unique // código para invitar (link de referido)
  referred_by    Int? // id del usuario que lo refirió
  pro_by_referral Boolean @default(false) // el plan Pro vino del programa de referidos
  verification_token String?
  token_expires  DateTime?
  created_at    DateTime @default(now())
  pages         Page[]
  password_resets PasswordReset[]

  @@map("users") // Mapea este modelo a la tabla 'users'
}

model Page {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title      String?
  slug       String   @unique
  bio        String?
  avatar_url String?
  whatsapp   String? // número para el botón destacado (solo dígitos)
  address    String? // dirección física, para el link a Google Maps
  payment_alias String? // alias o CVU para transferencias
  payment_link  String? // link de pago de MercadoPago
  reviews_url   String? // link a reseñas de Google
  hours      Json? // horarios: { mon: {open,close,closed}, ... }
  theme      Json?
  booking_settings Json? // reservas: { enabled, auto_confirm, max_days, min_minutes }
  created_at DateTime @default(now())
  links      Link[]
  orders     Order[]
  menus      Menu[]
  events     StatEvent[]
  booking_resources BookingResource[]
  bookings          Booking[]
  booking_exceptions BookingException[]

  @@map("pages")
}

// ========================================
// RESERVAS / TURNERO
// Un recurso reservable: "Corte de pelo" (2 barberos), "Cancha de 5" (x2),
// "Mesa para 4" (x3). quantity = unidades simultáneas del mismo recurso.
// ========================================
model BookingResource {
  id          Int      @id @default(autoincrement())
  page_id     Int
  page        Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  name        String
  description String?
  quantity    Int      @default(1) // unidades simultáneas (sillas, canchas, mesas)
  duration    Int      @default(60) // minutos por turno
  price       Decimal? @db.Decimal(10, 2)
  hours       Json? // horario semanal propio; null = usa el de la página
  active      Boolean  @default(true)
  position    Int      @default(0)
  created_at  DateTime @default(now())
  bookings    Booking[]
  exceptions  BookingException[]

  @@map("booking_resources")
}

model Booking {
  id             Int      @id @default(autoincrement())
  resource_id    Int
  resource       BookingResource @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  page_id        Int
  page           Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  starts_at      DateTime
  ends_at        DateTime
  customer_name  String
  customer_phone String // solo dígitos, canal de contacto con el cliente
  notes          String?
  status         String   @default("pending") // pending|confirmed|cancelled|no_show|done
  cancel_token   String   @unique // link de cancelación del cliente
  created_ip     String? // anti-abuso
  created_by_owner Boolean @default(false) // carga manual desde la centralita
  created_at     DateTime @default(now())

  @@index([resource_id, starts_at])
  @@index([page_id, starts_at])
  @@map("bookings")
}

// Bloqueos de fecha: feriados (resource_id null = toda la página) o
// mantenimiento de un recurso puntual.
model BookingException {
  id          Int      @id @default(autoincrement())
  page_id     Int
  page        Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  resource_id Int?
  resource    BookingResource? @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  reason      String?
  created_at  DateTime @default(now())

  @@map("booking_exceptions")
}

model Link {
  id         Int      @id @default(autoincrement())
  page_id    Int
  page       Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  title      String
  url        String
  position   Int      @default(0)
  clicks     Int      @default(0)
  created_at DateTime @default(now())

  @@map("links")
}

model Order {
  id            Int       @id @default(autoincrement())
  page_id       Int?
  page          Page?     @relation(fields: [page_id], references: [id], onDelete: SetNull)
  customer_name String?
  phone         String?
  address       String?
  items         Json? // [{itemId, name, qty, price}]
  total         Decimal?  @db.Decimal(10, 2)
  status        String    @default("pending")
  created_at    DateTime  @default(now())

  @@map("orders")
}

model Menu {
  id                  Int       @id @default(autoincrement())
  page_id             Int
  page                Page      @relation(fields: [page_id], references: [id], onDelete: Cascade)
  product_name        String?
  product_description String?
  category            String? // categoría del menú: "Cafés", "Promos", etc.
  image               String?
  items               Json? // [{itemId, name, qty, price}]
  price               Decimal?  @db.Decimal(10, 2)
  status              String    @default("active")
  created_at          DateTime  @default(now())

  @@map("menus")
}

model MinibioParam {
  id           Int       @id @default(autoincrement())
  param_code   String?
  param_code_2 String?
  varchar_1    String?
  varchar_2    String?
  varchar_3    String?
  json_1       Json?
  number_1     Decimal?  @db.Decimal(15, 2)
  number_2     Decimal?  @db.Decimal(15, 2)
  number_3     Decimal?  @db.Decimal(15, 2)
  date_1       DateTime? @db.Date
  date_2       DateTime? @db.Date
  created_at   DateTime  @default(now())

  @@map("minibio_param")
}

// Eventos de analítica: visitas a páginas y clicks en links
model StatEvent {
  id         Int      @id @default(autoincrement())
  page_id    Int
  page       Page     @relation(fields: [page_id], references: [id], onDelete: Cascade)
  link_id    Int?
  type       String // 'view' | 'click'
  created_at DateTime @default(now())

  @@index([page_id, created_at])
  @@map("stat_events")
}

// Planes: qué funcionalidades y límites tiene cada cuenta
model Plan {
  id         Int      @id @default(autoincrement())
  code       String   @unique // 'free', 'pro'
  name       String
  features   Json? // array de keys del catálogo: ["whatsapp","products",...]
  max_pages  Int      @default(1)
  max_links  Int      @default(10)
  is_default Boolean  @default(false) // plan de las cuentas nuevas / sin plan
  created_at DateTime @default(now())
  users      User[]

  @@map("plans")
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  user_id   Int
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token     String   @unique
  expires_at DateTime
  used_at   DateTime?
  created_at DateTime @default(now())

  @@map("password_resets")
}