PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/minibio
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
NODE_ENV=development
# En producción: lista de orígenes permitidos separados por coma
# CORS_ORIGINS=https://minibio.ar,https://www.minibio.ar,*.minibio.ar

# Emails transaccionales (verificación / reset de contraseña)
# Si no se configuran, el registro auto-verifica el email (modo dev)
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=465
# SMTP_USER=usuario
# SMTP_PASS=contraseña
# SMTP_FROM="MiniBio <no-reply@minibio.ar>"
# APP_URL=https://app.minibio.ar

# Asistente IA (beta) — key gratuita de Google AI Studio (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
